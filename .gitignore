# ==========================================================
#  SAFETY NET — do not delete this file.
#
#  One file reaches the internet:
#
#      docs/index.html
#
#  The real site, every asset, the audio, the renders, the
#  unpublished pages in docs/ — all ignored. `git add .`
#  cannot leak them. A file dropped into docs/ stays put
#  unless it is named below.
#
#  When you're ready to launch, see README.md.
# ==========================================================

# ignore everything at the top level...
/*

# ...except the safety net and the published folder
!/.gitignore
!/docs/

# inside docs/, ignore everything...
/docs/*

# ...except what is live right now.
# Publishing something new? Add its filename here, on its own line.
!/docs/index.html

# never publish these, ever
*.psd
*.blend
*.blend1
*.fbm/
Thumbs.db
.DS_Store
